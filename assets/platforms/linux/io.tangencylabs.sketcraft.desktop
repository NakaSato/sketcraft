[Desktop Entry]
Type=Application
Name=SketCraft
GenericName=3D CAD
Comment=Parametric 3D CAD: sketch, constrain, extrude, and change a parameter to rebuild
Exec=sketcraft %f
TryExec=sketcraft
Icon=io.tangencylabs.sketcraft
Terminal=false
StartupNotify=true
StartupWMClass=io.tangencylabs.sketcraft
Categories=Graphics;3DGraphics;Engineering;
Keywords=cad;3d;parametric;sketch;step;stl;modelling;modeling;
MimeType=application/x-sketcraft;model/step;model/iges;model/stl;model/3mf;
# Desktop ids of earlier releases; launchers keep pinned entries across the renames.
X-Flatpak-RenamedFrom=ai.storyteller.solvecraft.desktop;
