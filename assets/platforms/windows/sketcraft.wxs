<?xml version="1.0" encoding="utf-8"?>
<!--
  SketCraft MSI (WiX Toolset v5, plus the UI and Util extensions). Built by package.ps1:

    wix build sketcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc sketcraft.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install with a setup wizard: Welcome, install folder (Program Files\SketCraft by
  default, remembered for upgrades), Ready, progress, and a Finish page with a ticked "Launch
  SketCraft" box. Installs a Start Menu shortcut, sketcraft-cli (and adds its folder to the system PATH), the licence files (including
  THIRD-PARTY-LICENSES.txt), makes SketCraft the owner of `.sc` (and of the older `.sketcraft` and pre-rename `.solvecraft`), and offers it under
  "Open with" for STEP, IGES, 3MF and STL. `msiexec /qn` installs silently.
  Adapted from PhotoCraft's (storytold/photocraft, Apache-2.0; see ATTRIBUTION.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Never change the UpgradeCode: it is what lets a new MSI replace every earlier install,
       including those from before the SolveCraft -> SketCraft rename (docs/compatibility.md). -->
  <Package
      Name="SketCraft"
      Manufacturer="SketCraft contributors"
      Version="$(var.Version)"
      UpgradeCode="6A145FD6-D285-428D-AE84-A69570CDF4DB"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="SketCraft parametric 3D CAD" Manufacturer="SketCraft contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of SketCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Advertised shortcuts to an .exe need an .exe icon identifier (ICE50). -->
    <Icon Id="SketcraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SketcraftIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://docs.sketcraft.io/" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/NakaSato/sketcraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/NakaSato/sketcraft/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="SketCraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by SketcraftApp). -->
    <!-- Since the rename the folder and this key say SketCraft. A pre-rename install recorded
         Software\SolveCraft, which isn't read: its upgrade (same UpgradeCode) removes the old
         folder and installs into Program Files\SketCraft (docs/compatibility.md). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\SketCraft" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="SketCraft" Level="1">
      <ComponentGroupRef Id="SketcraftFiles" />
    </Feature>

    <!-- WixUI_InstallDir without its licence page (MIT OR Apache-2.0: nothing to accept). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSketcraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <Property Id="SketcraftVersion" Value="$(var.DisplayVersion)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="SketCraft $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch SketCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#SketcraftExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user. -->
    <CustomAction Id="LaunchSketcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="SketcraftFiles" Directory="INSTALLFOLDER">
      <!-- A new GUID with each rename: the key file changed from solvecraft.exe to sketcraft.exe,
           then to sketcraft.exe. The UpgradeCode above is unchanged, so this MSI major-upgrades a
           pre-rename install. -->
      <Component Id="SketcraftApp" Guid="F346A971-8C8E-4CA4-B21D-2238ADF442C1">
        <File Id="SketcraftExe" Source="$(var.BinDir)\sketcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="SketCraft"
              Description="SketCraft parametric 3D CAD" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="SketcraftIcon.exe" IconIndex="0" />
        </File>

        <!-- .sc: SketCraft's own format; SketCraft is its default app. -->
        <ProgId Id="Sketcraft.Design" Description="SketCraft Design" Icon="SketcraftExe" IconIndex="0">
          <Extension Id="sc" ContentType="application/x-sketcraft">
            <Verb Id="open" Command="Open" TargetFile="SketcraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Compatibility shim (docs/compatibility.md): designs saved as .sketcraft (before .sc)
             and as .solvecraft (before the first rename) open as the same ProgId. Registered by hand: a
             second Extension under one ProgId would write its open verb twice (WIX0091). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.sketcraft" Value="Sketcraft.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.sketcraft" Name="Content Type" Value="application/x-sketcraft" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Value="Sketcraft.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Name="Content Type" Value="application/x-solvecraft" Type="string" />
        <!-- STEP, IGES and meshes: offered under "Open with", never forced as the default. -->
        <ProgId Id="Sketcraft.Model" Description="3D model" Icon="SketcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sketcraft.Model\shell\open\command" Value="&quot;[#SketcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.step\OpenWithProgids" Name="Sketcraft.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stp\OpenWithProgids" Name="Sketcraft.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.igs\OpenWithProgids" Name="Sketcraft.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.iges\OpenWithProgids" Name="Sketcraft.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.3mf\OpenWithProgids" Name="Sketcraft.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stl\OpenWithProgids" Name="Sketcraft.Model" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "sketcraft"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sketcraft.exe" Name="FriendlyAppName" Value="SketCraft" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sketcraft.exe\shell\open\command" Value="&quot;[#SketcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sketcraft.exe\SupportedTypes" Name=".sc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sketcraft.exe\SupportedTypes" Name=".sketcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sketcraft.exe\SupportedTypes" Name=".solvecraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sketcraft.exe\SupportedTypes" Name=".step" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sketcraft.exe\SupportedTypes" Name=".stp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sketcraft.exe\SupportedTypes" Name=".igs" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sketcraft.exe\SupportedTypes" Name=".iges" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sketcraft.exe\SupportedTypes" Name=".3mf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sketcraft.exe\SupportedTypes" Name=".stl" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\sketcraft.exe" Value="[#SketcraftExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\SketCraft" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="SketcraftCli">
        <File Id="SketcraftCliExe" Source="$(var.BinDir)\sketcraft-cli.exe" KeyPath="yes" />
        <!-- The install folder on the system PATH, so MCP clients and shells find `sketcraft-cli` by name;
             removed again on uninstall. -->
        <Environment Id="SketcraftPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
      <!-- Compatibility shim (docs/compatibility.md): the old CLI name, forwarding to sketcraft-cli. -->
      <Component Id="SketcraftCliAlias">
        <File Id="SolvecraftCliAliasExe" Source="$(var.BinDir)\solvecraft-cli.exe" KeyPath="yes" />
      </Component>
      <!-- Several unversioned files: an explicit GUID (WIX0367). -->
      <Component Id="SketcraftLicences" Guid="CDEDEE8D-4BE9-4872-A2EA-EE623A6C7E91">
        <File Id="LicenseMit" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
        <File Id="LicenseApache" Source="$(var.BinDir)\LICENSE-APACHE" />
        <File Id="Notice" Source="$(var.BinDir)\NOTICE" />
        <File Id="ThirdParty" Source="$(var.BinDir)\THIRD-PARTY-LICENSES.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
